#!/usr/bin/env bash
set -uo pipefail

WORKDIR="${WORKDIR:-/workspace/SyncNetProject}"
RUN_SCRIPT="${1:?Usage: vast_worker <run_script>}"
STATUS_LOG=/workspace/status.log
BOOTSTRAP_LOG=/workspace/bootstrap.log
RUN_LOG=/workspace/run.log
RUN_PID_FILE=/workspace/run.pid

mkdir -p /workspace
touch "$STATUS_LOG"

status() {
  printf '%s | %s\n' "$(date '+%H:%M:%S')" "$*" >> "$STATUS_LOG"
}

fail_worker() {
  local code=$?
  status "FAILED worker exit=$code"
  touch /workspace/RUN_FAILED
  rm -f "$RUN_PID_FILE"
  exit "$code"
}

trap fail_worker ERR
exec >>"$BOOTSTRAP_LOG" 2>&1

status "WORKER_START $RUN_SCRIPT"
cd "$WORKDIR"

# Some images ship python3 only. Every campaign calls `python`, so make one
# available on PATH rather than patching each script (exit 127 otherwise).
if ! command -v python >/dev/null 2>&1; then
  if command -v python3 >/dev/null 2>&1; then
    mkdir -p /workspace/bin
    ln -sf "$(command -v python3)" /workspace/bin/python
    export PATH="/workspace/bin:$PATH"
    status "SHIM python -> $(command -v python3)"
  else
    status "FAILED no python or python3 on PATH"
    touch /workspace/RUN_FAILED
    exit 127
  fi
fi
status "PYTHON $(python -V 2>&1) at $(command -v python)"

status "INSTALLING requirements.txt"
python -m ensurepip --default-pip >/dev/null 2>&1 || true
# Ubuntu 24.04 images mark the system interpreter externally-managed (PEP 668):
# pip then refuses to install ANYTHING and exits 1 in about a second. These
# instances are disposable, so installing into the system env is correct here.
export PIP_BREAK_SYSTEM_PACKAGES=1 PIP_ROOT_USER_ACTION=ignore PIP_DISABLE_PIP_VERSION_CHECK=1
# If the image already ships torch, pin it so pip cannot pull a different one
# in as a dependency of accelerate (a silent version change would also make the
# golden fixtures drift). On a torch-less image this is a no-op and pip
# installs whatever torch accelerate asks for.
if python -c "import torch" >/dev/null 2>&1; then
  TORCH_V="$(python -c "import torch;print(torch.__version__.split('+')[0])")"
  printf 'torch==%s\n' "$TORCH_V" > /workspace/pip-constraints.txt
  export PIP_CONSTRAINT=/workspace/pip-constraints.txt
  status "TORCH preinstalled $TORCH_V (pinned; no re-download)"
else
  status "TORCH not in image -- pip will install it (~2.5 GB download)"
fi
python -m pip install -q --upgrade pip 2>/dev/null || status "WARNING pip self-upgrade skipped"
if ! python -m pip install -q -r requirements.txt; then
  status "PIP retrying with --break-system-packages --user"
  if ! python -m pip install -q --break-system-packages --user -r requirements.txt; then
    status "FAILED pip install (see bootstrap.log)"
    python -m pip install -r requirements.txt 2>&1 | tail -n 15
    touch /workspace/RUN_FAILED
    exit 1
  fi
fi
status "INSTALLED $(python -m pip --version 2>&1 | head -c 60)"

# The image may or may not ship torch. If it does, use it (its CUDA build is
# matched to the host); if not, install the cu128 wheel, which covers both
# 40- and 50-series. This makes the image choice non-critical.
if ! python -c "import torch" 2>/dev/null; then
  status "TORCH missing in image; installing cu128 wheel"
  python -m pip install -q torch --index-url https://download.pytorch.org/whl/cu128 \
    || status "WARNING torch install failed"
fi

status "VERIFYING GPU"
python - <<'PYCODE'
import os
import torch

print("torch:", torch.__version__)
print("cuda:", torch.version.cuda)
print("gpu:", torch.cuda.get_device_name(0))
print("capability:", torch.cuda.get_device_capability(0))
print("cudnn:", torch.backends.cudnn.version())
print("WANDB_API_KEY present:", bool(os.environ.get("WANDB_API_KEY")))
PYCODE

status "VERIFYING build (non-fatal)"
if python verify/verify_reference.py > /workspace/verify.log 2>&1; then
  status "VERIFY reference OK"
else
  status "WARNING verify_reference differs (torch/fixture drift; see verify.log)"
fi
python verify/verify_components.py >> /workspace/verify.log 2>&1 \
  && status "VERIFY components OK" || status "WARNING verify_components failed"

if [[ "$RUN_SCRIPT" = /* ]]; then
  SCRIPT_PATH="$RUN_SCRIPT"
else
  SCRIPT_PATH="$WORKDIR/$RUN_SCRIPT"
fi

if [ ! -f "$SCRIPT_PATH" ]; then
  echo "Run script not found: $SCRIPT_PATH"
  exit 2
fi

touch /workspace/READY
status "READY"
# Use every GPU the box actually has. NGPU (from --num-gpus) is only honoured
# when it is a positive integer; 0/unset/garbage means "detect", so renting an
# N-GPU box can never silently run on one GPU.
DETECTED=$(nvidia-smi -L 2>/dev/null | wc -l)
[ "${DETECTED:-0}" -ge 1 ] 2>/dev/null || DETECTED=1
if ! [[ "${NGPU:-}" =~ ^[1-9][0-9]*$ ]]; then
  NGPU="$DETECTED"
elif [ "$NGPU" -ne "$DETECTED" ]; then
  status "WARNING requested NGPU=$NGPU but box has $DETECTED GPU(s); using $DETECTED"
  NGPU="$DETECTED"
fi
export NGPU
status "GPUS $NGPU (detected $DETECTED)"
status "RUNNING $RUN_SCRIPT"

(
  tail -n 0 -F "$RUN_LOG" 2>/dev/null | while IFS= read -r line; do
    if [[ "$line" =~ ^ok[[:space:]]+(.+)$ ]]; then
      status "COMPLETED ${BASH_REMATCH[1]}"
    elif [[ "$line" =~ ^FAIL[[:space:]]+([^[:space:]]+) ]]; then
      status "FAILED ${BASH_REMATCH[1]}"
    elif [[ "$line" =~ ^\[shard\] ]] || [[ "$line" =~ launched ]] || [[ "$line" =~ ^shard[[:space:]] ]]; then
      status "$line"
    elif [[ "$line" =~ ^RUNNING[[:space:]] ]] || [[ "$line" =~ ^COMPLETED[[:space:]] ]] || [[ "$line" =~ ^FAILED[[:space:]] ]]; then
      status "$line"
    fi
  done
) &
BRIDGE_PID=$!

RUN_NAME="$(basename "$RUN_SCRIPT")"
CAMPAIGN_LOG_DIR="$WORKDIR/bash_scripts/logs/$RUN_NAME"
(
  declare -A SEEN
  while true; do
    if [ -d "$CAMPAIGN_LOG_DIR" ]; then
      while IFS= read -r file; do
        [ -n "$file" ] || continue
        if [ -z "${SEEN[$file]+x}" ]; then
          SEEN[$file]=1
          status "RUNNING $(basename "$file" .log)"
        fi
      done < <(find "$CAMPAIGN_LOG_DIR" -maxdepth 1 -type f -name '*.log' -print 2>/dev/null | sort)
    fi
    sleep 3
  done
) &
WATCHER_PID=$!

START_TS=$(date +%s)
set +e

# Own process group, so Ctrl-C stop from the local controller can terminate the full campaign tree.
setsid bash "$SCRIPT_PATH" >"$RUN_LOG" 2>&1 &
RUN_PID=$!
echo "$RUN_PID" > "$RUN_PID_FILE"
NEXT_HEARTBEAT=$((START_TS + 300))

while kill -0 "$RUN_PID" 2>/dev/null; do
  sleep 10
  NOW=$(date +%s)
  if [ "$NOW" -ge "$NEXT_HEARTBEAT" ] && kill -0 "$RUN_PID" 2>/dev/null; then
    status "RUNNING $RUN_SCRIPT elapsed=$((NOW - START_TS))s"
    NEXT_HEARTBEAT=$((NOW + 300))
  fi
done

wait "$RUN_PID"
RUN_STATUS=$?
rm -f "$RUN_PID_FILE"
set -e

kill "$BRIDGE_PID" "$WATCHER_PID" 2>/dev/null || true
wait "$BRIDGE_PID" "$WATCHER_PID" 2>/dev/null || true

if [ "$RUN_STATUS" -eq 0 ]; then
  status "COMPLETED $RUN_SCRIPT"
  touch /workspace/RUN_SUCCESS
  exit 0
fi

status "FAILED $RUN_SCRIPT exit=$RUN_STATUS"
touch /workspace/RUN_FAILED
exit "$RUN_STATUS"
