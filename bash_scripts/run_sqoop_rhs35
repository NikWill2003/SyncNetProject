#!/usr/bin/env bash
# run_sqoop_rhs35
# DATASET: SQOOP rhs=35  (the only dataset this script touches -- generated
# once, on demand, by the first run that needs it)
# 28 runs, ~22 GPU-h sequential on one GPU.
# WHY: the rhs=35 point of the compositional curve: all six baselines x3 plus the sync families, so every curve point is apples-to-apples
#     local  : bash bash_scripts/run_sqoop_rhs35
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/run_sqoop_rhs35
# Runs of one cell share a cfg_hash in wandb -- group by it to pool draws
# made on different boxes.
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
LOG="bash_scripts/logs/$CAMPAIGN"
mkdir -p "$LOG"

# one dataset per campaign: built once, serially, before any GPU starts
PREP="task=sqoop dataset.rhs_variety=35"

RUNS=(
  # ---- all six baselines x3 ----
  "sq35_base_conv_s0            task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_base_conv_s1            task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
  "sq35_base_conv_s2            task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=35 train.seed=2 wandb.tags=[v16,explore2]"
  "sq35_base_film_s0            task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_base_film_s1            task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
  "sq35_base_film_s2            task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=35 train.seed=2 wandb.tags=[v16,explore2]"
  "sq35_base_relnet_s0          task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_base_relnet_s1          task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
  "sq35_base_relnet_s2          task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=35 train.seed=2 wandb.tags=[v16,explore2]"
  "sq35_base_transformer_s0     task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_base_transformer_s1     task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
  "sq35_base_transformer_s2     task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=35 train.seed=2 wandb.tags=[v16,explore2]"
  "sq35_base_question_only_s0   task=sqoop experiment=sqoop/baselines/thesis/question_only dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_base_question_only_s1   task=sqoop experiment=sqoop/baselines/thesis/question_only dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
  "sq35_base_question_only_s2   task=sqoop experiment=sqoop/baselines/thesis/question_only dataset.rhs_variety=35 train.seed=2 wandb.tags=[v16,explore2]"
  "sq35_base_shared_workspace_s0 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_base_shared_workspace_s1 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
  "sq35_base_shared_workspace_s2 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace dataset.rhs_variety=35 train.seed=2 wandb.tags=[v16,explore2]"
  # ---- sync side ----
  "sq35_gated_s0                task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_gated_s1                task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
  "sq35_gated_s2                task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=35 train.seed=2 wandb.tags=[v16,explore2]"
  "sq35_tokens_stim_s0          task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_tokens_stim_s1          task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
  "sq35_tokens_stim_s2          task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=35 train.seed=2 wandb.tags=[v16,explore2]"
  "sq35_tokens_static_s0        task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_tokens_static_s1        task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
  "sq35_canonical_s0            task=sqoop experiment=sqoop/sync/thesis/canonical dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_canonical_s1            task=sqoop experiment=sqoop/sync/thesis/canonical dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,explore2]"
)

source bash_scripts/_campaign_lib.sh
run_campaign
