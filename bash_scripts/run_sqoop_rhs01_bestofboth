#!/usr/bin/env bash
# run_sqoop_rhs01_bestofboth
# DATASET: SQOOP rhs=1
# 5 runs, ~8 GPU-h on one GPU.
# WHY: held-out pairs at maximum sparsity: the compositional number (gated .821, FiLM .692)
#     local  : bash bash_scripts/run_sqoop_rhs01_bestofboth
