#!/usr/bin/env bash
# BOX 5 -- SQOOP baselines x3 seeds, rhs 18 only (one dataset). The
# reference points for the .974-vs-.500 dissociation. 18 runs, ~20-24 h.
#     bash bash_scripts/box5_sqoop_baselines          (inside tmux; single GPU, sequential)
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/$(basename "$0")
mkdir -p "$LOG"

RUNS=(
  "sq_base_conv_s0            task=sqoop experiment=sqoop/baselines/thesis/conv train.seed=0 wandb.tags=[v16,explore2]"
  "sq_base_conv_s1            task=sqoop experiment=sqoop/baselines/thesis/conv train.seed=1 wandb.tags=[v16,explore2]"
  "sq_base_conv_s2            task=sqoop experiment=sqoop/baselines/thesis/conv train.seed=2 wandb.tags=[v16,explore2]"
  "sq_base_film_s0            task=sqoop experiment=sqoop/baselines/thesis/film train.seed=0 wandb.tags=[v16,explore2]"
  "sq_base_film_s1            task=sqoop experiment=sqoop/baselines/thesis/film train.seed=1 wandb.tags=[v16,explore2]"
  "sq_base_film_s2            task=sqoop experiment=sqoop/baselines/thesis/film train.seed=2 wandb.tags=[v16,explore2]"
  "sq_base_relnet_s0          task=sqoop experiment=sqoop/baselines/thesis/relnet train.seed=0 wandb.tags=[v16,explore2]"
  "sq_base_relnet_s1          task=sqoop experiment=sqoop/baselines/thesis/relnet train.seed=1 wandb.tags=[v16,explore2]"
  "sq_base_relnet_s2          task=sqoop experiment=sqoop/baselines/thesis/relnet train.seed=2 wandb.tags=[v16,explore2]"
  "sq_base_transformer_s0     task=sqoop experiment=sqoop/baselines/thesis/transformer train.seed=0 wandb.tags=[v16,explore2]"
  "sq_base_transformer_s1     task=sqoop experiment=sqoop/baselines/thesis/transformer train.seed=1 wandb.tags=[v16,explore2]"
  "sq_base_transformer_s2     task=sqoop experiment=sqoop/baselines/thesis/transformer train.seed=2 wandb.tags=[v16,explore2]"
  "sq_base_question_only_s0   task=sqoop experiment=sqoop/baselines/thesis/question_only train.seed=0 wandb.tags=[v16,explore2]"
  "sq_base_question_only_s1   task=sqoop experiment=sqoop/baselines/thesis/question_only train.seed=1 wandb.tags=[v16,explore2]"
  "sq_base_question_only_s2   task=sqoop experiment=sqoop/baselines/thesis/question_only train.seed=2 wandb.tags=[v16,explore2]"
  "sq_base_shared_workspace_s0 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace train.seed=0 wandb.tags=[v16,explore2]"
  "sq_base_shared_workspace_s1 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace train.seed=1 wandb.tags=[v16,explore2]"
  "sq_base_shared_workspace_s2 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace train.seed=2 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
