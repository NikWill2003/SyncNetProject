#!/usr/bin/env bash
# BOX 15 -- DATASET: SQOOP rhs=1   (every run in this script uses this
# one dataset, so it is generated at most once on the box)
# Compositional stress, baselines x3 seeds.
#     bash bash_scripts/box15_sqoop01_baselines      (tmux; one GPU, sequential)
# Runs of one cell across boxes share a cfg_hash in wandb -- group by it
# to pool distributed draws.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box15_sqoop01_baselines
mkdir -p "$LOG"

RUNS=(
  "sq1_base_film_s0             task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_base_film_s1             task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_base_film_s2             task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_base_conv_s0             task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_base_conv_s1             task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_base_conv_s2             task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_base_relnet_s0           task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_base_relnet_s1           task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_base_relnet_s2           task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_base_transformer_s0      task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_base_transformer_s1      task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_base_transformer_s2      task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
