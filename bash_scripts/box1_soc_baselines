#!/usr/bin/env bash
# BOX 1 -- Sort-of-CLEVR baselines: the six thesis baselines x3 seeds
# (+2 extra transformer seeds; it is historically seed-hungry). One
# dataset; ~20 runs, ~12-16 h.
#     bash bash_scripts/box1_soc_baselines          (inside tmux; single GPU, sequential)
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/$(basename "$0")
mkdir -p "$LOG"

RUNS=(
  "soc_base_conv_s0           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/conv train.seed=0 wandb.tags=[v16,explore2]"
  "soc_base_conv_s1           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/conv train.seed=1 wandb.tags=[v16,explore2]"
  "soc_base_conv_s2           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/conv train.seed=2 wandb.tags=[v16,explore2]"
  "soc_base_film_s0           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/film train.seed=0 wandb.tags=[v16,explore2]"
  "soc_base_film_s1           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/film train.seed=1 wandb.tags=[v16,explore2]"
  "soc_base_film_s2           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/film train.seed=2 wandb.tags=[v16,explore2]"
  "soc_base_relnet_s0         task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet train.seed=0 wandb.tags=[v16,explore2]"
  "soc_base_relnet_s1         task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet train.seed=1 wandb.tags=[v16,explore2]"
  "soc_base_relnet_s2         task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet train.seed=2 wandb.tags=[v16,explore2]"
  "soc_base_transformer_s0    task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer train.seed=0 wandb.tags=[v16,explore2]"
  "soc_base_transformer_s1    task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer train.seed=1 wandb.tags=[v16,explore2]"
  "soc_base_transformer_s2    task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer train.seed=2 wandb.tags=[v16,explore2]"
  "soc_base_question_only_s0  task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/question_only train.seed=0 wandb.tags=[v16,explore2]"
  "soc_base_question_only_s1  task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/question_only train.seed=1 wandb.tags=[v16,explore2]"
  "soc_base_question_only_s2  task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/question_only train.seed=2 wandb.tags=[v16,explore2]"
  "soc_base_shared_workspace_s0 task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace train.seed=0 wandb.tags=[v16,explore2]"
  "soc_base_shared_workspace_s1 task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace train.seed=1 wandb.tags=[v16,explore2]"
  "soc_base_shared_workspace_s2 task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace train.seed=2 wandb.tags=[v16,explore2]"
  "soc_base_transformer_s3    task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer train.seed=3 wandb.tags=[v16,explore2]"
  "soc_base_transformer_s4    task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer train.seed=4 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
