#!/usr/bin/env bash
# BOX 01 -- DATASET: Sort-of-CLEVR   (every run in this script uses this
# one dataset, so it is generated at most once on the box)
# The heavy baselines x5 seeds: conv, film, relnet.
#     bash bash_scripts/box01_soc_baselines_a      (tmux; one GPU, sequential)
# Runs of one cell across boxes share a cfg_hash in wandb -- group by it
# to pool distributed draws.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box01_soc_baselines_a
mkdir -p "$LOG"

RUNS=(
  "soc_base_conv_s0             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/conv train.seed=0 wandb.tags=[v16,explore2]"
  "soc_base_conv_s1             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/conv train.seed=1 wandb.tags=[v16,explore2]"
  "soc_base_conv_s2             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/conv train.seed=2 wandb.tags=[v16,explore2]"
  "soc_base_conv_s3             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/conv train.seed=3 wandb.tags=[v16,explore2]"
  "soc_base_conv_s4             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/conv train.seed=4 wandb.tags=[v16,explore2]"
  "soc_base_film_s0             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/film train.seed=0 wandb.tags=[v16,explore2]"
  "soc_base_film_s1             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/film train.seed=1 wandb.tags=[v16,explore2]"
  "soc_base_film_s2             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/film train.seed=2 wandb.tags=[v16,explore2]"
  "soc_base_film_s3             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/film train.seed=3 wandb.tags=[v16,explore2]"
  "soc_base_film_s4             task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/film train.seed=4 wandb.tags=[v16,explore2]"
  "soc_base_relnet_s0           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet train.seed=0 wandb.tags=[v16,explore2]"
  "soc_base_relnet_s1           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet train.seed=1 wandb.tags=[v16,explore2]"
  "soc_base_relnet_s2           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet train.seed=2 wandb.tags=[v16,explore2]"
  "soc_base_relnet_s3           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet train.seed=3 wandb.tags=[v16,explore2]"
  "soc_base_relnet_s4           task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet train.seed=4 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
