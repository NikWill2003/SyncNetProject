#!/usr/bin/env bash
# BOX 05 -- SoC addressing + gated-arm ablations x5 seeds.
#     bash bash_scripts/box05_soc_ablations_addr_gated          (tmux; one GPU, sequential; duplicates of
#     sweep cells are extra lottery draws, never waste)
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box05_soc_ablations_addr_gated
mkdir -p "$LOG"

RUNS=(
  "soc_abl_addresses_static_s0  task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_static train.seed=0 wandb.tags=[v16,explore2]"
  "soc_abl_addresses_static_s1  task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_static train.seed=1 wandb.tags=[v16,explore2]"
  "soc_abl_addresses_static_s2  task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_static train.seed=2 wandb.tags=[v16,explore2]"
  "soc_abl_addresses_static_s3  task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_static train.seed=3 wandb.tags=[v16,explore2]"
  "soc_abl_addresses_static_s4  task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_static train.seed=4 wandb.tags=[v16,explore2]"
  "soc_abl_addresses_open_s0    task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_open train.seed=0 wandb.tags=[v16,explore2]"
  "soc_abl_addresses_open_s1    task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_open train.seed=1 wandb.tags=[v16,explore2]"
  "soc_abl_addresses_open_s2    task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_open train.seed=2 wandb.tags=[v16,explore2]"
  "soc_abl_addresses_open_s3    task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_open train.seed=3 wandb.tags=[v16,explore2]"
  "soc_abl_addresses_open_s4    task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/addresses_open train.seed=4 wandb.tags=[v16,explore2]"
  "soc_abl_gated_attn_s0        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_attn train.seed=0 wandb.tags=[v16,explore2]"
  "soc_abl_gated_attn_s1        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_attn train.seed=1 wandb.tags=[v16,explore2]"
  "soc_abl_gated_attn_s2        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_attn train.seed=2 wandb.tags=[v16,explore2]"
  "soc_abl_gated_attn_s3        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_attn train.seed=3 wandb.tags=[v16,explore2]"
  "soc_abl_gated_attn_s4        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_attn train.seed=4 wandb.tags=[v16,explore2]"
  "soc_abl_gated_full_s0        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_full train.seed=0 wandb.tags=[v16,explore2]"
  "soc_abl_gated_full_s1        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_full train.seed=1 wandb.tags=[v16,explore2]"
  "soc_abl_gated_full_s2        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_full train.seed=2 wandb.tags=[v16,explore2]"
  "soc_abl_gated_full_s3        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_full train.seed=3 wandb.tags=[v16,explore2]"
  "soc_abl_gated_full_s4        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/gated_full train.seed=4 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
