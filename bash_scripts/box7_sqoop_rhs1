#!/usr/bin/env bash
# BOX 7 -- the compositional stress, rhs=1 only (one dataset): held-out
# pairs at maximum sparsity. Baselines x2, gated x3, both token controls
# x2, canonical x2 for the record. Same tree/data caveat as box 6 for the
# token runs. ~17 runs, ~19-23 h.
#     bash bash_scripts/box7_sqoop_rhs1          (inside tmux; single GPU, sequential)
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/$(basename "$0")
mkdir -p "$LOG"

RUNS=(
  "sq1_film_s0                task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_film_s1                task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_conv_s0                task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_conv_s1                task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_relnet_s0              task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_relnet_s1              task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_transformer_s0         task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_transformer_s1         task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_gated_s0               task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_gated_s1               task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_gated_s2               task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_tokens_stim_s0         task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_tokens_stim_s1         task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_tokens_static_s0       task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_tokens_static_s1       task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_canonical_s0           task=sqoop experiment=sqoop/sync/thesis/canonical dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_canonical_s1           task=sqoop experiment=sqoop/sync/thesis/canonical dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
