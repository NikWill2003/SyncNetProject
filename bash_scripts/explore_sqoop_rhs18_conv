#!/usr/bin/env bash
# explore_sqoop_rhs18_conv
# DATASET: SQOOP rhs=18 (one dataset)
# 20 runs (2 seeds; 1 for single-purpose controls), ~24 GPU-h.
# WHY: Conv+LSTM (paper architecture): optimisation levers and width only
# Exploratory: find the configuration for this baseline BEFORE spending 5 seeds x 6
# splits on it. Dataset held constant. See bash_scripts/BASELINE_CHANGES.md.
# READ: the best config becomes this model's row in the final_* scripts; the
# base row is what the shared stem alone does.
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/explore_sqoop_rhs18_conv
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
LOG="bash_scripts/logs/$CAMPAIGN"
mkdir -p "$LOG"

PREP="task=sqoop dataset.rhs_variety=18"

RUNS=(
  "cv_base_s0                 task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_base_s1                 task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv train.seed=1 wandb.tags=[v16,explore_baselines]"
  "cv_eb2048_s0               task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv train.grad_accum=8 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_eb2048_s1               task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv train.grad_accum=8 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "cv_lr1e4_s0                task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv optim.lr=1e-4 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_lr1e4_s1                task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv optim.lr=1e-4 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "cv_wd0_s0                  task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv optim.weight_decay=0 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_wd0_s1                  task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv optim.weight_decay=0 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "cv_eb2048_wd0_s0           task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv train.grad_accum=8 optim.weight_decay=0 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_eb2048_wd0_s1           task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv train.grad_accum=8 optim.weight_decay=0 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "cv_h512_s0                 task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv model.hidden_dim=512 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_h512_s1                 task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv model.hidden_dim=512 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "cv_h128_s0                 task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv model.hidden_dim=128 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_h128_s1                 task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv model.hidden_dim=128 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "cv_lr1e4_wd0_s0            task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv optim.lr=1e-4 optim.weight_decay=0 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_lr1e4_wd0_s1            task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv optim.lr=1e-4 optim.weight_decay=0 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "cv_eb2048_lr1e4_wd0_s0     task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv train.grad_accum=8 optim.lr=1e-4 optim.weight_decay=0 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_eb2048_lr1e4_wd0_s1     task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv train.grad_accum=8 optim.lr=1e-4 optim.weight_decay=0 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "cv_warm10k_s0              task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv optim.lr_scheduler_params.warmup_steps=10000 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "cv_warm10k_s1              task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/conv optim.lr_scheduler_params.warmup_steps=10000 train.seed=1 wandb.tags=[v16,explore_baselines]"
)

source bash_scripts/_campaign_lib.sh
run_campaign
