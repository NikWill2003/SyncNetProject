#!/usr/bin/env bash
# Build every dataset the campaign needs, at most JOBS at a time (default
# 3): Sort-of-CLEVR once, SQOOP once per rhs variety. Each sqoop build
# peaks around ~14 GB RAM, so lower JOBS (JOBS=2 ...) on smaller boxes.
# Per-job logs in bash_scripts/logs/. Edit the rhs list to trim the sweep.
set -u
cd "$(dirname "$0")/.."
mkdir -p bash_scripts/logs
rm -f bash_scripts/logs/.failed
JOBS=${JOBS:-3}

prep() {  # prep <name> <hydra overrides...>
  local n=$1; shift
  if python -m scripts.prepare_dataset "$@" > "bash_scripts/logs/$n.log" 2>&1
  then echo "ok   $n"
  else echo "FAIL $n  (bash_scripts/logs/$n.log)"; touch bash_scripts/logs/.failed
  fi
}

prep sort_of_clevr task=sort_of_clevr &
for rhs in 1 2 4 8 18 35; do
  while (( $(jobs -rp | wc -l) >= JOBS )); do wait -n; done
  prep "sqoop_rhs$rhs" task=sqoop dataset.rhs_variety="$rhs" &
done
wait
[ ! -e bash_scripts/logs/.failed ]