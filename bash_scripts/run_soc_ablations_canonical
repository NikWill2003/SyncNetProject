#!/usr/bin/env bash
# run_soc_ablations_canonical
# DATASET: Sort-of-CLEVR
# 45 runs, ~50 GPU-h on one GPU.
# WHY: the ablation table: canonical model minus one component, 5 seeds each; read as accuracy AND assembly rate
#
# CANONICAL MODEL = identity bus net + spatial bias on the competition + NO
# readout prior term (Chapter 3). Every run below is the canonical model with
# exactly ONE change. If run_soc_readout_prior shows the prior term matters,
# flip the single CANON line and re-run.
#     local  : bash bash_scripts/run_soc_ablations_canonical
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/run_soc_ablations_canonical
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
LOG="bash_scripts/logs/$CAMPAIGN"
mkdir -p "$LOG"

PREP="task=sort_of_clevr"

CANON="task=sort_of_clevr experiment=sort_of_clevr/sync/hybrids/identity_spatial model.readout_prior=false"

RUNS=(
  # ---- the canonical model itself ----
  "soc_canonical_s0           $CANON train.seed=0 wandb.tags=[v16,canonical]"
  "soc_canonical_s1           $CANON train.seed=1 wandb.tags=[v16,canonical]"
  "soc_canonical_s2           $CANON train.seed=2 wandb.tags=[v16,canonical]"
  "soc_canonical_s3           $CANON train.seed=3 wandb.tags=[v16,canonical]"
  "soc_canonical_s4           $CANON train.seed=4 wandb.tags=[v16,canonical]"
  # ---- binding ----
  "soc_no_bias_s0             $CANON model.claim_prior=null train.seed=0 wandb.tags=[v16,canonical]"
  "soc_no_bias_s1             $CANON model.claim_prior=null train.seed=1 wandb.tags=[v16,canonical]"
  "soc_no_bias_s2             $CANON model.claim_prior=null train.seed=2 wandb.tags=[v16,canonical]"
  "soc_no_bias_s3             $CANON model.claim_prior=null train.seed=3 wandb.tags=[v16,canonical]"
  "soc_no_bias_s4             $CANON model.claim_prior=null train.seed=4 wandb.tags=[v16,canonical]"
  "soc_hard_partition_s0      $CANON model.claim_prior_init=partition model.claim_prior_scale=50 train.seed=0 wandb.tags=[v16,canonical]"
  "soc_hard_partition_s1      $CANON model.claim_prior_init=partition model.claim_prior_scale=50 train.seed=1 wandb.tags=[v16,canonical]"
  "soc_hard_partition_s2      $CANON model.claim_prior_init=partition model.claim_prior_scale=50 train.seed=2 wandb.tags=[v16,canonical]"
  "soc_hard_partition_s3      $CANON model.claim_prior_init=partition model.claim_prior_scale=50 train.seed=3 wandb.tags=[v16,canonical]"
  "soc_hard_partition_s4      $CANON model.claim_prior_init=partition model.claim_prior_scale=50 train.seed=4 wandb.tags=[v16,canonical]"
  # ---- identity ----
  "soc_anchors_off_s0         $CANON model.per_module_anchors=false train.seed=0 wandb.tags=[v16,canonical]"
  "soc_anchors_off_s1         $CANON model.per_module_anchors=false train.seed=1 wandb.tags=[v16,canonical]"
  "soc_anchors_off_s2         $CANON model.per_module_anchors=false train.seed=2 wandb.tags=[v16,canonical]"
  "soc_anchors_off_s3         $CANON model.per_module_anchors=false train.seed=3 wandb.tags=[v16,canonical]"
  "soc_anchors_off_s4         $CANON model.per_module_anchors=false train.seed=4 wandb.tags=[v16,canonical]"
  "soc_cells_off_s0           $CANON model.private_cells=false train.seed=0 wandb.tags=[v16,canonical]"
  "soc_cells_off_s1           $CANON model.private_cells=false train.seed=1 wandb.tags=[v16,canonical]"
  "soc_cells_off_s2           $CANON model.private_cells=false train.seed=2 wandb.tags=[v16,canonical]"
  "soc_cells_off_s3           $CANON model.private_cells=false train.seed=3 wandb.tags=[v16,canonical]"
  "soc_cells_off_s4           $CANON model.private_cells=false train.seed=4 wandb.tags=[v16,canonical]"
  # ---- medium ----
  "soc_silent_s0              $CANON model.medium=silent train.seed=0 wandb.tags=[v16,canonical]"
  "soc_silent_s1              $CANON model.medium=silent train.seed=1 wandb.tags=[v16,canonical]"
  "soc_silent_s2              $CANON model.medium=silent train.seed=2 wandb.tags=[v16,canonical]"
  "soc_silent_s3              $CANON model.medium=silent train.seed=3 wandb.tags=[v16,canonical]"
  "soc_silent_s4              $CANON model.medium=silent train.seed=4 wandb.tags=[v16,canonical]"
  "soc_static_addr_s0         $CANON model.addresses=static train.seed=0 wandb.tags=[v16,canonical]"
  "soc_static_addr_s1         $CANON model.addresses=static train.seed=1 wandb.tags=[v16,canonical]"
  "soc_static_addr_s2         $CANON model.addresses=static train.seed=2 wandb.tags=[v16,canonical]"
  "soc_static_addr_s3         $CANON model.addresses=static train.seed=3 wandb.tags=[v16,canonical]"
  "soc_static_addr_s4         $CANON model.addresses=static train.seed=4 wandb.tags=[v16,canonical]"
  "soc_lines_attn_s0          $CANON model.medium=lines model.gate=attn train.seed=0 wandb.tags=[v16,canonical]"
  "soc_lines_attn_s1          $CANON model.medium=lines model.gate=attn train.seed=1 wandb.tags=[v16,canonical]"
  "soc_lines_attn_s2          $CANON model.medium=lines model.gate=attn train.seed=2 wandb.tags=[v16,canonical]"
  "soc_lines_attn_s3          $CANON model.medium=lines model.gate=attn train.seed=3 wandb.tags=[v16,canonical]"
  "soc_lines_attn_s4          $CANON model.medium=lines model.gate=attn train.seed=4 wandb.tags=[v16,canonical]"
  # ---- stem (separate cell: encoder is a dict) ----
  "soc_cnn_stem_s0            task=sort_of_clevr experiment=sort_of_clevr/sync/hybrids/identity_spatial_cnnenc model.readout_prior=false train.seed=0 wandb.tags=[v16,canonical]"
  "soc_cnn_stem_s1            task=sort_of_clevr experiment=sort_of_clevr/sync/hybrids/identity_spatial_cnnenc model.readout_prior=false train.seed=1 wandb.tags=[v16,canonical]"
  "soc_cnn_stem_s2            task=sort_of_clevr experiment=sort_of_clevr/sync/hybrids/identity_spatial_cnnenc model.readout_prior=false train.seed=2 wandb.tags=[v16,canonical]"
  "soc_cnn_stem_s3            task=sort_of_clevr experiment=sort_of_clevr/sync/hybrids/identity_spatial_cnnenc model.readout_prior=false train.seed=3 wandb.tags=[v16,canonical]"
  "soc_cnn_stem_s4            task=sort_of_clevr experiment=sort_of_clevr/sync/hybrids/identity_spatial_cnnenc model.readout_prior=false train.seed=4 wandb.tags=[v16,canonical]"
)

source bash_scripts/_campaign_lib.sh
run_campaign
