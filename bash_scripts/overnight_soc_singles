#!/usr/bin/env bash
# Run single full protocol runs (seed 0) on THIS machine's one GPU, one
# cell after another. Invoke on box B:  bash bash_scripts/overnight_soc_singles
# (box A runs overnight_sqoop_overfit). ~3-4 h per cell: the four thesis
# cells fill one night; swap in the ablation block for night two.
# Logs: bash_scripts/logs/soc_singles/.   SKIP_PREP=1 keeps existing data.
set -u
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/soc_singles
mkdir -p "$LOG"

if [ "${SKIP_PREP:-0}" != 1 ]; then
  rm -rf data/sqoop-* data/sort_of_clevr-*
  bash_scripts/prepare_datasets_parallel || exit 1
fi

CELLS=(
  sync/thesis/canonical
  sync/thesis/identity
  sync/thesis/gated
  sync/thesis/tokens
  # -- night two: comment the four above, uncomment these ------------
  # sync/ablations/medium_silent
  # sync/ablations/addresses_static
  # sync/ablations/medium_lines_attn
  # sync/ablations/identity_cells_only
)

FAILED=0
for cell in "${CELLS[@]}"; do
  name=$(echo "$cell" | tr '/' '_')
  if python -m scripts.main task=sort_of_clevr experiment=sort_of_clevr/$cell \
       train.seed=0 > "$LOG/$name.log" 2>&1
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED