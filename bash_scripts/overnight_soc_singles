#!/usr/bin/env bash
# Run single full protocol runs (seed 0) on THIS machine's one GPU, one
# cell after another, streaming every run's log to the terminal (and to
# bash_scripts/logs/soc_singles/). Invoke on box B:
#     bash bash_scripts/overnight_soc_singles
# No dataset step: a missing dataset is generated on demand by the first
# run that needs it. STALE pre-v16 caches are NOT refreshed by that --
# wipe once per box:  rm -rf data/sort_of_clevr-*
# ~3-4 h per cell: the four thesis cells fill one night; swap in the
# ablation block for night two.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/soc_singles
mkdir -p "$LOG"

CELLS=(
  sync/thesis/canonical
  sync/thesis/identity
  sync/thesis/gated
  sync/thesis/tokens
  # -- night two: comment the four above, uncomment these ------------
  # sync/ablations/medium_silent
  # sync/ablations/addresses_static
  # sync/ablations/medium_lines_attn
  # sync/ablations/identity_cells_only
)

FAILED=0
for cell in "${CELLS[@]}"; do
  name=$(echo "$cell" | tr '/' '_')
  if python -u -m scripts.main task=sort_of_clevr experiment=sort_of_clevr/$cell \
       train.seed=0 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
