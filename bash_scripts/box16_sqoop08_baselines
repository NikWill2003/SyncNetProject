#!/usr/bin/env bash
# BOX 16 -- DATASET: SQOOP rhs=8  |  18 runs, ~14 h
# WHY: ALL six baselines x3 seeds at rhs=8 -- the full comparison curve, not just film/conv; question_only is the prior floor at this sparsity
#     bash bash_scripts/box16_sqoop08_baselines      (tmux; one GPU, sequential)
# Runs of one cell share a cfg_hash in wandb; group by it to pool draws.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box16_sqoop08_baselines
mkdir -p "$LOG"

RUNS=(
  "sq8_base_conv_s0             task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_base_conv_s1             task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_base_conv_s2             task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=8 train.seed=2 wandb.tags=[v16,explore2]"
  "sq8_base_film_s0             task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_base_film_s1             task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_base_film_s2             task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=8 train.seed=2 wandb.tags=[v16,explore2]"
  "sq8_base_relnet_s0           task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_base_relnet_s1           task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_base_relnet_s2           task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=8 train.seed=2 wandb.tags=[v16,explore2]"
  "sq8_base_transformer_s0      task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_base_transformer_s1      task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_base_transformer_s2      task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=8 train.seed=2 wandb.tags=[v16,explore2]"
  "sq8_base_question_only_s0    task=sqoop experiment=sqoop/baselines/thesis/question_only dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_base_question_only_s1    task=sqoop experiment=sqoop/baselines/thesis/question_only dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_base_question_only_s2    task=sqoop experiment=sqoop/baselines/thesis/question_only dataset.rhs_variety=8 train.seed=2 wandb.tags=[v16,explore2]"
  "sq8_base_shared_workspace_s0 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_base_shared_workspace_s1 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_base_shared_workspace_s2 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace dataset.rhs_variety=8 train.seed=2 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
