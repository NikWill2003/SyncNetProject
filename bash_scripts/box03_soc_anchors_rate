#!/usr/bin/env bash
# BOX 03 -- DATASET: Sort-of-CLEVR   (every run in this script uses this
# one dataset, so it is generated at most once on the box)
# THE DECISIVE BATCH: anchors_only to n~14, cells_only to n~6.
# Registered: anchors_only assembly rate >> canonical ~10%; cells_only ~0.
#     bash bash_scripts/box03_soc_anchors_rate      (tmux; one GPU, sequential)
# Runs of one cell across boxes share a cfg_hash in wandb -- group by it
# to pool distributed draws.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box03_soc_anchors_rate
mkdir -p "$LOG"

RUNS=(
  "soc_anchors_only_s4          task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=4 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s5          task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=5 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s6          task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=6 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s7          task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=7 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s8          task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=8 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s9          task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=9 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s10         task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=10 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s11         task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=11 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s12         task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=12 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s13         task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=13 wandb.tags=[v16,explore2]"
  "soc_cells_only_s4            task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_cells_only train.seed=4 wandb.tags=[v16,explore2]"
  "soc_cells_only_s5            task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_cells_only train.seed=5 wandb.tags=[v16,explore2]"
  "soc_cells_only_s6            task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_cells_only train.seed=6 wandb.tags=[v16,explore2]"
  "soc_cells_only_s7            task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_cells_only train.seed=7 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
