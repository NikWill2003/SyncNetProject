  "rn_ps5_base_s0             task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/relnet train.seed=0 train.loader_mode=dataloader train.num_workers=6 wandb.tags=[v16,explore_baselines]"
