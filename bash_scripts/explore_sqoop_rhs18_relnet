  "rn_ps16_s0                 task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/relnet model.pair_spatial=16 train.seed=0 train.loader_mode=dataloader train.num_workers=6 wandb.tags=[v16,explore_baselines]"
  "rn_ps8_eb2048_s0           task=sqoop dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/relnet model.pair_spatial=8 train.grad_accum=8 train.seed=0 train.loader_mode=dataloader train.num_workers=6 wandb.tags=[v16,explore_baselines]"
