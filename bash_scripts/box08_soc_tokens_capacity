#!/usr/bin/env bash
# BOX 08 -- DATASET: Sort-of-CLEVR   (every run in this script uses this
# one dataset, so it is generated at most once on the box)
# Tokens to x5, the count_obtuse probes (settling depth vs channel
# width), and canonical capacity probes.
#     bash bash_scripts/box08_soc_tokens_capacity      (tmux; one GPU, sequential)
# Runs of one cell across boxes share a cfg_hash in wandb -- group by it
# to pool distributed draws.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box08_soc_tokens_capacity
mkdir -p "$LOG"

RUNS=(
  "soc_tokens_s1                task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens train.seed=1 wandb.tags=[v16,explore2]"
  "soc_tokens_s2                task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens train.seed=2 wandb.tags=[v16,explore2]"
  "soc_tokens_s3                task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens train.seed=3 wandb.tags=[v16,explore2]"
  "soc_tokens_s4                task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens train.seed=4 wandb.tags=[v16,explore2]"
  "soc_tokens_T16_s0            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens model.t_bus=16 train.seed=0 wandb.tags=[v16,explore2]"
  "soc_tokens_T16_s1            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens model.t_bus=16 train.seed=1 wandb.tags=[v16,explore2]"
  "soc_tokens_T16_s2            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens model.t_bus=16 train.seed=2 wandb.tags=[v16,explore2]"
  "soc_tokens_msg8_s0           task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens model.msg_dim=8 train.seed=0 wandb.tags=[v16,explore2]"
  "soc_tokens_msg8_s1           task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens model.msg_dim=8 train.seed=1 wandb.tags=[v16,explore2]"
  "soc_tokens_msg8_s2           task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/tokens model.msg_dim=8 train.seed=2 wandb.tags=[v16,explore2]"
  "soc_canonical_d8_s0          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.phase_dim=8 train.seed=0 wandb.tags=[v16,explore2]"
  "soc_canonical_d8_s1          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.phase_dim=8 train.seed=1 wandb.tags=[v16,explore2]"
  "soc_canonical_d8_s2          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.phase_dim=8 train.seed=2 wandb.tags=[v16,explore2]"
  "soc_canonical_msg8_s0        task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.msg_dim=8 train.seed=0 wandb.tags=[v16,explore2]"
  "soc_canonical_msg8_s1        task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.msg_dim=8 train.seed=1 wandb.tags=[v16,explore2]"
  "soc_canonical_msg8_s2        task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.msg_dim=8 train.seed=2 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
