#
# BASE SETTINGS every run inherits (the frozen protocol; conf/experiment/
# <task>/_protocol.yaml), unless a line below overrides them:
#   optimiser   AdamW  lr 3e-4  weight_decay 0.01  grad_clip 1.0
#   schedule    warmup-cosine, 2k warmup, 100k steps uniform, no early stop
#   batch       train 256 / val 1024,  bf16,  torch.compile on,
#               loader gpu_cached,  eval + train log every 500 steps
#   checkpoint  best-on-val; test metrics reported from best weights
#   data        SoC: 36k scenes / 10 q each / test 1k (dataset seed 1)
#               SQOOP: 1.08M train / 25.6k test, rhs 18 unless overridden;
#               questions one-hot vocab 40
#   models      canonical busnet: M=6(+head) dm=96 msg=4 d=6 T=8 dt=0.5
#               medium=bus addresses=computed; identity adds private cells
#               + per-module anchors; gated: grid=2 msg=16 d=2 T=8
#               gate=phase; tokens: scenes in, no encoder
#   callbacks   SoC: accuracy + interventions + fixed-point signature
#               SQOOP: accuracy + fixed-point signature
#   tags        [v16, explore1]  (evidence tier, never cited directly)
#
#     GPU i (of 8):  SHARD=i NSHARDS=8 GPU=i bash bash_scripts/explore1
# or just:           bash bash_scripts/explore1_launch   (prep + all 8)
# Logs: bash_scripts/logs/explore1/.  EXTRA appends overrides to every
# run -- e.g. EXTRA=train.compile_model=false if 8-way compile contention
# dominates on a shared box (measure steady-state sps first).
set -uo pipefail
