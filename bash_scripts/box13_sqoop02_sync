#!/usr/bin/env bash
# BOX 13 -- DATASET: SQOOP rhs=2  |  10 runs, ~8 h
# WHY: the sync side of the rhs=2 point: gated (the family that works on sqoop), both token controls, field models for the record
#     bash bash_scripts/box13_sqoop02_sync      (tmux; one GPU, sequential)
# Runs of one cell share a cfg_hash in wandb; group by it to pool draws.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box13_sqoop02_sync
mkdir -p "$LOG"

RUNS=(
  "sq2_gated_s0                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=2 train.seed=0 wandb.tags=[v16,explore2]"
  "sq2_gated_s1                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=2 train.seed=1 wandb.tags=[v16,explore2]"
  "sq2_gated_s2                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=2 train.seed=2 wandb.tags=[v16,explore2]"
  "sq2_tokens_stim_s0           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=2 train.seed=0 wandb.tags=[v16,explore2]"
  "sq2_tokens_stim_s1           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=2 train.seed=1 wandb.tags=[v16,explore2]"
  "sq2_tokens_stim_s2           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=2 train.seed=2 wandb.tags=[v16,explore2]"
  "sq2_tokens_static_s0         task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=2 train.seed=0 wandb.tags=[v16,explore2]"
  "sq2_tokens_static_s1         task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=2 train.seed=1 wandb.tags=[v16,explore2]"
  "sq2_canonical_s0             task=sqoop experiment=sqoop/sync/thesis/canonical dataset.rhs_variety=2 train.seed=0 wandb.tags=[v16,explore2]"
  "sq2_canonical_s1             task=sqoop experiment=sqoop/sync/thesis/canonical dataset.rhs_variety=2 train.seed=1 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
