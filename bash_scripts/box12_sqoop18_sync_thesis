#!/usr/bin/env bash
# BOX 12 -- DATASET: SQOOP rhs=18   (every run in this script uses this
# one dataset, so it is generated at most once on the box)
# PREREQUISITE (once per box): rm -rf data/sqoop-*  -- the token cells
# need scenes-bearing data; the first run regenerates it.
# Token controls x5 (the stale-clone reruns), gated to x6, T16 arm.
#     bash bash_scripts/box12_sqoop18_sync_thesis      (tmux; one GPU, sequential)
# Runs of one cell across boxes share a cfg_hash in wandb -- group by it
# to pool distributed draws.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box12_sqoop18_sync_thesis
mkdir -p "$LOG"

RUNS=(
  "sq_tokens_stim_s0            task=sqoop experiment=sqoop/sync/thesis/tokens_stim train.seed=0 wandb.tags=[v16,explore2]"
  "sq_tokens_stim_s1            task=sqoop experiment=sqoop/sync/thesis/tokens_stim train.seed=1 wandb.tags=[v16,explore2]"
  "sq_tokens_stim_s2            task=sqoop experiment=sqoop/sync/thesis/tokens_stim train.seed=2 wandb.tags=[v16,explore2]"
  "sq_tokens_stim_s3            task=sqoop experiment=sqoop/sync/thesis/tokens_stim train.seed=3 wandb.tags=[v16,explore2]"
  "sq_tokens_stim_s4            task=sqoop experiment=sqoop/sync/thesis/tokens_stim train.seed=4 wandb.tags=[v16,explore2]"
  "sq_tokens_static_s0          task=sqoop experiment=sqoop/sync/thesis/tokens_static train.seed=0 wandb.tags=[v16,explore2]"
  "sq_tokens_static_s1          task=sqoop experiment=sqoop/sync/thesis/tokens_static train.seed=1 wandb.tags=[v16,explore2]"
  "sq_tokens_static_s2          task=sqoop experiment=sqoop/sync/thesis/tokens_static train.seed=2 wandb.tags=[v16,explore2]"
  "sq_tokens_static_s3          task=sqoop experiment=sqoop/sync/thesis/tokens_static train.seed=3 wandb.tags=[v16,explore2]"
  "sq_tokens_static_s4          task=sqoop experiment=sqoop/sync/thesis/tokens_static train.seed=4 wandb.tags=[v16,explore2]"
  "sq_gated_s3                  task=sqoop experiment=sqoop/sync/thesis/gated train.seed=3 wandb.tags=[v16,explore2]"
  "sq_gated_s4                  task=sqoop experiment=sqoop/sync/thesis/gated train.seed=4 wandb.tags=[v16,explore2]"
  "sq_gated_s5                  task=sqoop experiment=sqoop/sync/thesis/gated train.seed=5 wandb.tags=[v16,explore2]"
  "sq_canonical_T16_s0          task=sqoop experiment=sqoop/sync/thesis/canonical model.t_bus=16 train.seed=0 wandb.tags=[v16,explore2]"
  "sq_canonical_T16_s1          task=sqoop experiment=sqoop/sync/thesis/canonical model.t_bus=16 train.seed=1 wandb.tags=[v16,explore2]"
  "sq_canonical_T16_s2          task=sqoop experiment=sqoop/sync/thesis/canonical model.t_bus=16 train.seed=2 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
