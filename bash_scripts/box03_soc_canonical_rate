#!/usr/bin/env bash
# BOX 03 -- canonical rate to n~30 draws + the T-regime arms
# (registered: T16 assembly rate <= T8, per-assembled acc unchanged).
#     bash bash_scripts/box03_soc_canonical_rate          (tmux; one GPU, sequential; duplicates of
#     sweep cells are extra lottery draws, never waste)
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box03_soc_canonical_rate
mkdir -p "$LOG"

RUNS=(
  "soc_canonical_s10            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=10 wandb.tags=[v16,explore2]"
  "soc_canonical_s11            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=11 wandb.tags=[v16,explore2]"
  "soc_canonical_s12            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=12 wandb.tags=[v16,explore2]"
  "soc_canonical_s13            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=13 wandb.tags=[v16,explore2]"
  "soc_canonical_s14            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=14 wandb.tags=[v16,explore2]"
  "soc_canonical_s15            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=15 wandb.tags=[v16,explore2]"
  "soc_canonical_s16            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=16 wandb.tags=[v16,explore2]"
  "soc_canonical_s17            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=17 wandb.tags=[v16,explore2]"
  "soc_canonical_s18            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=18 wandb.tags=[v16,explore2]"
  "soc_canonical_s19            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=19 wandb.tags=[v16,explore2]"
  "soc_canonical_T16_s0         task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.t_bus=16 train.seed=0 wandb.tags=[v16,explore2]"
  "soc_canonical_T16_s1         task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.t_bus=16 train.seed=1 wandb.tags=[v16,explore2]"
  "soc_canonical_T16_s2         task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.t_bus=16 train.seed=2 wandb.tags=[v16,explore2]"
  "soc_canonical_T16_s3         task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.t_bus=16 train.seed=3 wandb.tags=[v16,explore2]"
  "soc_canonical_T16_s4         task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.t_bus=16 train.seed=4 wandb.tags=[v16,explore2]"
  "soc_canonical_T4_s0          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.t_bus=4 train.seed=0 wandb.tags=[v16,explore2]"
  "soc_canonical_T4_s1          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.t_bus=4 train.seed=1 wandb.tags=[v16,explore2]"
  "soc_canonical_T4_s2          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical model.t_bus=4 train.seed=2 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
