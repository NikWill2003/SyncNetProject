#!/usr/bin/env bash
# BOX 12 -- DATASET: SQOOP rhs=4  |  12 runs, ~8 h
# WHY: one point of the generalisation curve (rhs=4); the curve shape decides how many points the paper-ready pass needs
#     bash bash_scripts/box12_sqoop04_curve      (tmux; one GPU, sequential)
# Runs of one cell share a cfg_hash in wandb; group by it to pool draws
# scattered across boxes.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box12_sqoop04_curve
mkdir -p "$LOG"

RUNS=(
  "sq4_gated_s0                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=4 train.seed=0 wandb.tags=[v16,explore2]"
  "sq4_gated_s1                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=4 train.seed=1 wandb.tags=[v16,explore2]"
  "sq4_gated_s2                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=4 train.seed=2 wandb.tags=[v16,explore2]"
  "sq4_film_s0                  task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=4 train.seed=0 wandb.tags=[v16,explore2]"
  "sq4_film_s1                  task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=4 train.seed=1 wandb.tags=[v16,explore2]"
  "sq4_film_s2                  task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=4 train.seed=2 wandb.tags=[v16,explore2]"
  "sq4_tokens_stim_s0           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=4 train.seed=0 wandb.tags=[v16,explore2]"
  "sq4_tokens_stim_s1           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=4 train.seed=1 wandb.tags=[v16,explore2]"
  "sq4_tokens_stim_s2           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=4 train.seed=2 wandb.tags=[v16,explore2]"
  "sq4_conv_s0                  task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=4 train.seed=0 wandb.tags=[v16,explore2]"
  "sq4_conv_s1                  task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=4 train.seed=1 wandb.tags=[v16,explore2]"
  "sq4_conv_s2                  task=sqoop experiment=sqoop/baselines/thesis/conv dataset.rhs_variety=4 train.seed=2 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
