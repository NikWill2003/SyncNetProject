#!/usr/bin/env bash
# BOX 8 -- the rhs generalisation curve {2,4,8,35} for the three working
# families (gated / film / tokens_stim). The one deliberate multi-dataset
# script: it pays 4 on-demand generations (~30-40 min each) because a
# curve cannot live on one dataset. ~16 runs, ~18-22 h.
#     bash bash_scripts/box8_sqoop_rhs_curve          (inside tmux; single GPU, sequential)
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/$(basename "$0")
mkdir -p "$LOG"

RUNS=(
  "sq2_gated_s0               task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=2 train.seed=0 wandb.tags=[v16,explore2]"
  "sq2_film_s0                task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=2 train.seed=0 wandb.tags=[v16,explore2]"
  "sq2_tokens_stim_s0         task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=2 train.seed=0 wandb.tags=[v16,explore2]"
  "sq4_gated_s0               task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=4 train.seed=0 wandb.tags=[v16,explore2]"
  "sq4_film_s0                task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=4 train.seed=0 wandb.tags=[v16,explore2]"
  "sq4_tokens_stim_s0         task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=4 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_gated_s0               task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_film_s0                task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_tokens_stim_s0         task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_gated_s0              task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_film_s0               task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq35_tokens_stim_s0        task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,explore2]"
  "sq2_gated_s1               task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=2 train.seed=1 wandb.tags=[v16,explore2]"
  "sq2_film_s1                task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=2 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_gated_s1               task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_film_s1                task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
