  "relnet_rhs2_s1       task=sqoop train.loader_mode=dataloader train.num_workers=6 dataset.rhs_variety=2 experiment=sqoop/baselines/thesis/relnet model.pair_spatial=8 train.grad_accum=8 train.n_steps=20000 train.seed=1 wandb.tags=[v16,final]"
