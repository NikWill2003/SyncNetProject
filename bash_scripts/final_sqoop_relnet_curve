#!/usr/bin/env bash
# final_sqoop_relnet_curve
# DATASET: SQOOP rhs 1,18,2,4,8,35 (a curve for ONE model; rhs=1 and 18 first, at 3 seeds -- escape is stochastic)
# 14 runs, ~42 GPU-h (~3 h each; grad_accum 8 makes every step 8x, the shorter schedule pays it back).
# WHY: RelNet trains at 8x8 pairing + effective batch 2048, and its validation curve reaches ceiling by 5k steps; 20k steps is 4x that margin at a fifth of the 100k-step cost.
# Protocol deviations to state in the table footnote: effective batch 2048, and the step count.
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/final_sqoop_relnet_curve
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
LOG="bash_scripts/logs/$CAMPAIGN"
mkdir -p "$LOG"

PREP="task=sqoop dataset.rhs_variety=1"

RUNS=(
  # ---- rhs=1 (3 seeds) ----
  "relnet_rhs1_s0       task=sqoop train.loader_mode=dataloader train.num_workers=6 dataset.rhs_variety=1 experiment=sqoop/baselines/thesis/relnet model.pair_spatial=8 train.grad_accum=8 train.n_steps=20000 train.seed=0 wandb.tags=[v16,final]"
  "relnet_rhs1_s1       task=sqoop train.loader_mode=dataloader train.num_workers=6 dataset.rhs_variety=1 experiment=sqoop/baselines/thesis/relnet model.pair_spatial=8 train.grad_accum=8 train.n_steps=20000 train.seed=1 wandb.tags=[v16,final]"
  "relnet_rhs1_s2       task=sqoop train.loader_mode=dataloader train.num_workers=6 dataset.rhs_variety=1 experiment=sqoop/baselines/thesis/relnet model.pair_spatial=8 train.grad_accum=8 train.n_steps=20000 train.seed=2 wandb.tags=[v16,final]"
  # ---- rhs=18 (3 seeds) ----
  "relnet_rhs18_s0      task=sqoop train.loader_mode=dataloader train.num_workers=6 dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/relnet model.pair_spatial=8 train.grad_accum=8 train.n_steps=20000 train.seed=0 wandb.tags=[v16,final]"
  "relnet_rhs18_s1      task=sqoop train.loader_mode=dataloader train.num_workers=6 dataset.rhs_variety=18 experiment=sqoop/baselines/thesis/relnet model.pair_spatial=8 train.grad_accum=8 train.n_steps=20000 train.seed=1 wandb.tags=[v16,final]"
