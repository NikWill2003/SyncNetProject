#!/usr/bin/env bash
# explore_soc_baselines
# DATASET: Sort-of-CLEVR
# 20 runs, ~18 GPU-h.
# WHY: the paper-form transformer (.839) and workspace (.858) are below FiLM (.955)
# and RelNet (.874) on SoC. On SQOOP the lever was the learning rate (lr 1e-4 on
# the shared stem: .50 -> .98 at grad_accum 1), not batch size. This applies the
# same lever on SoC, plus depth, so the two rows can be replaced by tuned,
# stem-matched ones. Every run uses the standard SoC protocol otherwise.
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/explore_soc_baselines
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
LOG="bash_scripts/logs/$CAMPAIGN"
mkdir -p "$LOG"

PREP="task=sort_of_clevr"

RUNS=(
  # ---- Transformer on the shared stem: the SQOOP lever (lr 1e-4) first, then depth ----
  "soc_transformer_stem_s0          task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer train.seed=0 wandb.tags=[v16,explore_baselines]"
  "soc_transformer_stem_s1          task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer train.seed=1 wandb.tags=[v16,explore_baselines]"
  "soc_transformer_stem_s2          task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer train.seed=2 wandb.tags=[v16,explore_baselines]"
  "soc_transformer_stem_lr1e4_s0    task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer optim.lr=1e-4 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "soc_transformer_stem_lr1e4_s1    task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer optim.lr=1e-4 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "soc_transformer_stem_lr1e4_s2    task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer optim.lr=1e-4 train.seed=2 wandb.tags=[v16,explore_baselines]"
  "soc_transformer_stem_L4_s0       task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer model.n_layers=4 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "soc_transformer_stem_L4_s1       task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer model.n_layers=4 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "soc_transformer_stem_L4_lr1e4_s0 task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer model.n_layers=4 optim.lr=1e-4 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "soc_transformer_stem_L4_lr1e4_s1 task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/transformer model.n_layers=4 optim.lr=1e-4 train.seed=1 wandb.tags=[v16,explore_baselines]"
  # ---- Workspace on the shared stem ----
  "soc_workspace_stem_s0            task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace train.seed=0 wandb.tags=[v16,explore_baselines]"
  "soc_workspace_stem_s1            task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace train.seed=1 wandb.tags=[v16,explore_baselines]"
  "soc_workspace_stem_s2            task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace train.seed=2 wandb.tags=[v16,explore_baselines]"
  "soc_workspace_stem_lr1e4_s0      task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace optim.lr=1e-4 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "soc_workspace_stem_lr1e4_s1      task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace optim.lr=1e-4 train.seed=1 wandb.tags=[v16,explore_baselines]"
  "soc_workspace_stem_lr1e4_s2      task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace optim.lr=1e-4 train.seed=2 wandb.tags=[v16,explore_baselines]"
  "soc_workspace_stem_topk10_s0     task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace model.topk_frac=1.0 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "soc_workspace_stem_unlooped_s0   task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/shared_workspace model.share_layer_weights=false train.seed=0 wandb.tags=[v16,explore_baselines]"
  # ---- RelNet: pairing resolution ----
  "soc_relnet_ps8_s0                task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet model.pair_spatial=8 train.seed=0 wandb.tags=[v16,explore_baselines]"
  "soc_relnet_ps8_s1                task=sort_of_clevr experiment=sort_of_clevr/baselines/thesis/relnet model.pair_spatial=8 train.seed=1 wandb.tags=[v16,explore_baselines]"
)

source bash_scripts/_campaign_lib.sh
run_campaign
