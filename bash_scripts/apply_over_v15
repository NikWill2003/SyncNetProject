#!/usr/bin/env bash
# Overlay repair: `unzip` over an existing v15 checkout ADDS and OVERWRITES
# but never DELETES, so every retired path survives the unpack -- the old
# sync models reappear next to the new ones, the era experiment dirs sit at
# their original locations, and the OLD flat baselines yamls merge INTO the
# new baselines/ family dir, making the thesis/scratch division look
# broken. This script removes exactly the superseded paths.
#
#   bash_scripts/apply_over_v15            dry run: list what would go
#   bash_scripts/apply_over_v15 --apply    actually delete, then run
#                                          verify/verify_tree.py
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

SUPERSEDED=(
  src/models/sync/syncnet.py
  src/models/sync/phasebind.py
  src/models/sync/fieldsync.py
  src/models/sync/osc_field.py
  src/models/sync/common
  conf/model/sort_of_clevr/syncnet.yaml
  conf/model/sort_of_clevr/phasebind.yaml
  conf/model/sort_of_clevr/fieldsync.yaml
  conf/model/sort_of_clevr/osc_field.yaml
  conf/model/sqoop/syncnet.yaml
  conf/experiment/sort_of_clevr/sync_a
  conf/experiment/sort_of_clevr/sync_b
  conf/experiment/sort_of_clevr/sync_c
  conf/experiment/sort_of_clevr/sync_d
  conf/experiment/sort_of_clevr/syncnet
  conf/experiment/sqoop/busnet
  conf/experiment/sqoop/diagnostics
  conf/experiment/sqoop/syncnet
)
# old flat era yamls that merged into the new baselines/ family dirs
for task in sort_of_clevr sqoop; do
  for f in conf/experiment/$task/baselines/*.yaml; do
    [ -e "$f" ] || continue
    [ "$(basename "$f")" = "_family.yaml" ] && continue
    SUPERSEDED+=("$f")
  done
done

apply=${1:-}
found=0
for p in "${SUPERSEDED[@]}"; do
    [ -e "$p" ] || continue
    found=1
    if [ "$apply" = "--apply" ]; then
        rm -rf "$p" && echo "[removed] $p"
    else
        echo "[stale]   $p"
    fi
done
if [ "$found" = 0 ]; then
    echo "clean: no superseded v15 paths present"
elif [ "$apply" != "--apply" ]; then
    echo; echo "dry run only -- rerun with --apply to delete the above"
fi
[ "$apply" = "--apply" ] && { echo; python3 verify/verify_tree.py; }
exit 0
