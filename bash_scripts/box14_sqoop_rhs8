#!/usr/bin/env bash
# BOX 14 -- one point of the rhs generalisation curve: rhs=8 only
# (one dataset per box, as designed). Token runs need scenes-bearing data.
#     bash bash_scripts/box14_sqoop_rhs8          (tmux; one GPU, sequential; duplicates of
#     sweep cells are extra lottery draws, never waste)
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box14_sqoop_rhs8
mkdir -p "$LOG"

RUNS=(
  "sq8_gated_s0                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_gated_s1                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_gated_s2                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=8 train.seed=2 wandb.tags=[v16,explore2]"
  "sq8_film_s0                  task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_film_s1                  task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_film_s2                  task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=8 train.seed=2 wandb.tags=[v16,explore2]"
  "sq8_tokens_stim_s0           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_tokens_stim_s1           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
  "sq8_tokens_stim_s2           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=8 train.seed=2 wandb.tags=[v16,explore2]"
  "sq8_tokens_static_s0         task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=8 train.seed=0 wandb.tags=[v16,explore2]"
  "sq8_tokens_static_s1         task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=8 train.seed=1 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
