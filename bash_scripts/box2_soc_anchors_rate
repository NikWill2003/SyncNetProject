  "soc_anchors_only_s2        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=2 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s3        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=3 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s4        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=4 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s5        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=5 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s6        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=6 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s7        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=7 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s8        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=8 wandb.tags=[v16,explore2]"
  "soc_anchors_only_s9        task=sort_of_clevr experiment=sort_of_clevr/sync/ablations/identity_anchors_only train.seed=9 wandb.tags=[v16,explore2]"
  "soc_canonical_x10          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=10 wandb.tags=[v16,explore2]"
  "soc_canonical_x11          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=11 wandb.tags=[v16,explore2]"
  "soc_canonical_x12          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=12 wandb.tags=[v16,explore2]"
  "soc_canonical_x13          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=13 wandb.tags=[v16,explore2]"
  "soc_canonical_x14          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=14 wandb.tags=[v16,explore2]"
  "soc_canonical_x15          task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/canonical train.seed=15 wandb.tags=[v16,explore2]"
  "soc_identity_s5            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/identity train.seed=5 wandb.tags=[v16,explore2]"
  "soc_identity_s6            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/identity train.seed=6 wandb.tags=[v16,explore2]"
  "soc_identity_s7            task=sort_of_clevr experiment=sort_of_clevr/sync/thesis/identity train.seed=7 wandb.tags=[v16,explore2]"
