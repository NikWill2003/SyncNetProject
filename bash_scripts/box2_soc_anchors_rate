#!/usr/bin/env bash
# BOX 2 -- the decisive assembly-rate head-to-head: anchors_only x10
# draws vs canonical (+6 fresh draws, rate n->27) vs identity (+4).
# Registered prediction: anchors_only full-assembly rate >> canonical's
# ~10%. ~20 runs, ~13-16 h.
#     bash bash_scripts/box2_soc_anchors_rate          (inside tmux; single GPU, sequential)
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/$(basename "$0")
mkdir -p "$LOG"

