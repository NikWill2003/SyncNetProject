#!/usr/bin/env bash
# BOX 09 -- DATASET: SQOOP rhs=1  |  28 runs, ~26 h
# WHY: held-out-pair generalisation is the SQOOP chapter claim: baselines x3, gated x5, token controls x3, field for the record
