#!/usr/bin/env bash
# BOX 09 -- DATASET: Sort-of-CLEVR   (every run in this script uses this
# one dataset, so it is generated at most once on the box)
# Encoder-matched arm x5. Registered: gaps that persist under a shared
# encoder are mechanism; gaps that close were the encoder.
#     bash bash_scripts/box09_soc_matched_encoder      (tmux; one GPU, sequential)
# Runs of one cell across boxes share a cfg_hash in wandb -- group by it
# to pool distributed draws.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box09_soc_matched_encoder
mkdir -p "$LOG"

RUNS=(
  "matched_film_fieldenc_s0     task=sort_of_clevr experiment=sort_of_clevr/matched/film_fieldenc train.seed=0"
  "matched_film_fieldenc_s1     task=sort_of_clevr experiment=sort_of_clevr/matched/film_fieldenc train.seed=1"
  "matched_film_fieldenc_s2     task=sort_of_clevr experiment=sort_of_clevr/matched/film_fieldenc train.seed=2"
  "matched_film_fieldenc_s3     task=sort_of_clevr experiment=sort_of_clevr/matched/film_fieldenc train.seed=3"
  "matched_film_fieldenc_s4     task=sort_of_clevr experiment=sort_of_clevr/matched/film_fieldenc train.seed=4"
  "matched_conv_fieldenc_s0     task=sort_of_clevr experiment=sort_of_clevr/matched/conv_fieldenc train.seed=0"
  "matched_conv_fieldenc_s1     task=sort_of_clevr experiment=sort_of_clevr/matched/conv_fieldenc train.seed=1"
  "matched_conv_fieldenc_s2     task=sort_of_clevr experiment=sort_of_clevr/matched/conv_fieldenc train.seed=2"
  "matched_conv_fieldenc_s3     task=sort_of_clevr experiment=sort_of_clevr/matched/conv_fieldenc train.seed=3"
  "matched_conv_fieldenc_s4     task=sort_of_clevr experiment=sort_of_clevr/matched/conv_fieldenc train.seed=4"
  "matched_busnet_cnnenc_s0     task=sort_of_clevr experiment=sort_of_clevr/matched/busnet_cnnenc train.seed=0"
  "matched_busnet_cnnenc_s1     task=sort_of_clevr experiment=sort_of_clevr/matched/busnet_cnnenc train.seed=1"
  "matched_busnet_cnnenc_s2     task=sort_of_clevr experiment=sort_of_clevr/matched/busnet_cnnenc train.seed=2"
  "matched_busnet_cnnenc_s3     task=sort_of_clevr experiment=sort_of_clevr/matched/busnet_cnnenc train.seed=3"
  "matched_busnet_cnnenc_s4     task=sort_of_clevr experiment=sort_of_clevr/matched/busnet_cnnenc train.seed=4"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
