#!/usr/bin/env bash
# BOX 10 -- DATASET: SQOOP rhs=18   (every run in this script uses this
# one dataset, so it is generated at most once on the box)
# Heavy sqoop baselines x5: conv, film, relnet.
#     bash bash_scripts/box10_sqoop18_baselines_a      (tmux; one GPU, sequential)
# Runs of one cell across boxes share a cfg_hash in wandb -- group by it
# to pool distributed draws.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/box10_sqoop18_baselines_a
mkdir -p "$LOG"

RUNS=(
  "sq_base_conv_s0              task=sqoop experiment=sqoop/baselines/thesis/conv train.seed=0 wandb.tags=[v16,explore2]"
  "sq_base_conv_s1              task=sqoop experiment=sqoop/baselines/thesis/conv train.seed=1 wandb.tags=[v16,explore2]"
  "sq_base_conv_s2              task=sqoop experiment=sqoop/baselines/thesis/conv train.seed=2 wandb.tags=[v16,explore2]"
  "sq_base_conv_s3              task=sqoop experiment=sqoop/baselines/thesis/conv train.seed=3 wandb.tags=[v16,explore2]"
  "sq_base_conv_s4              task=sqoop experiment=sqoop/baselines/thesis/conv train.seed=4 wandb.tags=[v16,explore2]"
  "sq_base_film_s0              task=sqoop experiment=sqoop/baselines/thesis/film train.seed=0 wandb.tags=[v16,explore2]"
  "sq_base_film_s1              task=sqoop experiment=sqoop/baselines/thesis/film train.seed=1 wandb.tags=[v16,explore2]"
  "sq_base_film_s2              task=sqoop experiment=sqoop/baselines/thesis/film train.seed=2 wandb.tags=[v16,explore2]"
  "sq_base_film_s3              task=sqoop experiment=sqoop/baselines/thesis/film train.seed=3 wandb.tags=[v16,explore2]"
  "sq_base_film_s4              task=sqoop experiment=sqoop/baselines/thesis/film train.seed=4 wandb.tags=[v16,explore2]"
  "sq_base_relnet_s0            task=sqoop experiment=sqoop/baselines/thesis/relnet train.seed=0 wandb.tags=[v16,explore2]"
  "sq_base_relnet_s1            task=sqoop experiment=sqoop/baselines/thesis/relnet train.seed=1 wandb.tags=[v16,explore2]"
  "sq_base_relnet_s2            task=sqoop experiment=sqoop/baselines/thesis/relnet train.seed=2 wandb.tags=[v16,explore2]"
  "sq_base_relnet_s3            task=sqoop experiment=sqoop/baselines/thesis/relnet train.seed=3 wandb.tags=[v16,explore2]"
  "sq_base_relnet_s4            task=sqoop experiment=sqoop/baselines/thesis/relnet train.seed=4 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
