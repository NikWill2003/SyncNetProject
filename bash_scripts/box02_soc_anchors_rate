#!/usr/bin/env bash
# BOX 02 -- the decisive identity dissection: anchors_only to n~14 draws,
# cells_only to n~6, identity thesis to n~13. Registered: anchors_only
# full-assembly rate >> canonical ~10%; cells_only ~0.
#     bash bash_scripts/box02_soc_anchors_rate          (tmux; one GPU, sequential; duplicates of
#     sweep cells are extra lottery draws, never waste)
