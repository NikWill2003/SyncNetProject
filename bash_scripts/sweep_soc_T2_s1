  "soc_T2_d2_M4_s1          task=sort_of_clevr experiment=sort_of_clevr/sync/hybrids/identity_spatial model.readout_prior=false model.t_bus=2 model.phase_dim=2 model.n_modules=4 train.seed=1 wandb.tags=[v16,grid]"
