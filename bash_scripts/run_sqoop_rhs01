#!/usr/bin/env bash
# run_sqoop_rhs01
# DATASET: SQOOP rhs=1  (the only dataset this script touches -- generated
# once, on demand, by the first run that needs it)
# 46 runs, ~45 GPU-h sequential on one GPU.
# WHY: the rhs=1 point of the compositional curve: held-out pairs at this sparsity for every family plus the ablation trio: does the L2 ordering survive maximum sparsity?
#     bash bash_scripts/run_sqoop_rhs01      (run inside tmux)
# Every run of one cell shares a cfg_hash in wandb -- group by it to pool
# draws made on different boxes.
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/run_sqoop_rhs01
mkdir -p "$LOG"

