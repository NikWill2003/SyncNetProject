#!/usr/bin/env bash
# run_sqoop_rhs01
# DATASET: SQOOP rhs=1  (the only dataset this script touches -- built ONCE,
# serially, before any GPU worker starts)
# 46 runs. On an N-GPU box they are dispatched from a shared queue, one
# experiment per GPU, so wall-clock is roughly total/N.
# Section order = priority: if the box dies early, the most valuable blocks
# are already done.
#     local  : bash bash_scripts/run_sqoop_rhs01
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/run_sqoop_rhs01
# Runs of one cell share a cfg_hash in wandb -- group by it to pool draws
# made on different boxes.
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
LOG="bash_scripts/logs/$CAMPAIGN"
mkdir -p "$LOG"

PREP="task=sqoop dataset.rhs_variety=1"

