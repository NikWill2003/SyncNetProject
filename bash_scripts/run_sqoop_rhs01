  "sq1_abl_gated_full_s0        task=sqoop experiment=sqoop/sync/ablations/gated_full dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_abl_gated_full_s1        task=sqoop experiment=sqoop/sync/ablations/gated_full dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_abl_identity_anchors_only_s0 task=sqoop experiment=sqoop/sync/ablations/identity_anchors_only dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_abl_identity_anchors_only_s1 task=sqoop experiment=sqoop/sync/ablations/identity_anchors_only dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
)

FAILED=0
for spec in "${RUNS[@]}"; do
  set -- $spec
  name=$1; shift
  if python -u -m scripts.main "$@" 2>&1 | tee "$LOG/$name.log"
  then echo "ok   $name"
  else echo "FAIL $name  ($LOG/$name.log)"; FAILED=1
  fi
done
exit $FAILED
