  "sq1_base_film_s1             task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_base_film_s2             task=sqoop experiment=sqoop/baselines/thesis/film dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_base_relnet_s0           task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_base_relnet_s1           task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_base_relnet_s2           task=sqoop experiment=sqoop/baselines/thesis/relnet dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_base_transformer_s0      task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_base_transformer_s1      task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_base_transformer_s2      task=sqoop experiment=sqoop/baselines/thesis/transformer dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_base_question_only_s0    task=sqoop experiment=sqoop/baselines/thesis/question_only dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_base_question_only_s1    task=sqoop experiment=sqoop/baselines/thesis/question_only dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_base_question_only_s2    task=sqoop experiment=sqoop/baselines/thesis/question_only dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_base_shared_workspace_s0 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_base_shared_workspace_s1 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_base_shared_workspace_s2 task=sqoop experiment=sqoop/baselines/thesis/shared_workspace dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  # ---- sync side: gated, both token controls, field models for the record ----
  "sq1_gated_s0                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_gated_s1                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_gated_s2                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_gated_s3                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=1 train.seed=3 wandb.tags=[v16,explore2]"
  "sq1_gated_s4                 task=sqoop experiment=sqoop/sync/thesis/gated dataset.rhs_variety=1 train.seed=4 wandb.tags=[v16,explore2]"
  "sq1_tokens_stim_s0           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_tokens_stim_s1           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_tokens_stim_s2           task=sqoop experiment=sqoop/sync/thesis/tokens_stim dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_tokens_static_s0         task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_tokens_static_s1         task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_tokens_static_s2         task=sqoop experiment=sqoop/sync/thesis/tokens_static dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_canonical_s0             task=sqoop experiment=sqoop/sync/thesis/canonical dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_canonical_s1             task=sqoop experiment=sqoop/sync/thesis/canonical dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_canonical_s2             task=sqoop experiment=sqoop/sync/thesis/canonical dataset.rhs_variety=1 train.seed=2 wandb.tags=[v16,explore2]"
  "sq1_identity_s0              task=sqoop experiment=sqoop/sync/thesis/identity dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_identity_s1              task=sqoop experiment=sqoop/sync/thesis/identity dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  # ---- ablations x2 under maximum sparsity ----
  "sq1_abl_medium_lines_attn_s0 task=sqoop experiment=sqoop/sync/ablations/medium_lines_attn dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_abl_medium_lines_attn_s1 task=sqoop experiment=sqoop/sync/ablations/medium_lines_attn dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
  "sq1_abl_medium_silent_s0     task=sqoop experiment=sqoop/sync/ablations/medium_silent dataset.rhs_variety=1 train.seed=0 wandb.tags=[v16,explore2]"
  "sq1_abl_medium_silent_s1     task=sqoop experiment=sqoop/sync/ablations/medium_silent dataset.rhs_variety=1 train.seed=1 wandb.tags=[v16,explore2]"
