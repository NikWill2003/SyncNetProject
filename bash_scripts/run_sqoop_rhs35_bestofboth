#!/usr/bin/env bash
# run_sqoop_rhs35_bestofboth
# DATASET: SQOOP rhs=35
# 5 runs, ~8 GPU-h on one GPU.
# CANONICAL readout (no question-only prior term), matching Chapter 3 and the ablation campaigns.
# WHY: rhs=35 point of the compositional curve for the .999 model, 5 seeds
#     local  : bash bash_scripts/run_sqoop_rhs35_bestofboth
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/run_sqoop_rhs35_bestofboth
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
LOG="bash_scripts/logs/$CAMPAIGN"
mkdir -p "$LOG"

PREP="task=sqoop dataset.rhs_variety=35"

RUNS=(
  "sq35_id_partition_cnn_s0     task=sqoop experiment=sqoop/sync/hybrids/identity_partition_cnnenc model.readout_prior=false dataset.rhs_variety=35 train.seed=0 wandb.tags=[v16,bestofboth]"
  "sq35_id_partition_cnn_s1     task=sqoop experiment=sqoop/sync/hybrids/identity_partition_cnnenc model.readout_prior=false dataset.rhs_variety=35 train.seed=1 wandb.tags=[v16,bestofboth]"
  "sq35_id_partition_cnn_s2     task=sqoop experiment=sqoop/sync/hybrids/identity_partition_cnnenc model.readout_prior=false dataset.rhs_variety=35 train.seed=2 wandb.tags=[v16,bestofboth]"
  "sq35_id_partition_cnn_s3     task=sqoop experiment=sqoop/sync/hybrids/identity_partition_cnnenc model.readout_prior=false dataset.rhs_variety=35 train.seed=3 wandb.tags=[v16,bestofboth]"
  "sq35_id_partition_cnn_s4     task=sqoop experiment=sqoop/sync/hybrids/identity_partition_cnnenc model.readout_prior=false dataset.rhs_variety=35 train.seed=4 wandb.tags=[v16,bestofboth]"
)

source bash_scripts/_campaign_lib.sh
run_campaign
