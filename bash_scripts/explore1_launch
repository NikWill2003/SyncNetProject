#!/usr/bin/env bash
# One command for the whole EXPLORE-1 night on a single 8-GPU machine:
#   1) builds ALL datasets fully in parallel (prepare_datasets_parallel:
#      Sort-of-CLEVR + sqoop rhs {1,2,4,8,18,35} -- all 7 at once by
#      default; peak RAM ~90-100 GB while the six sqoop train splits are
#      in memory, ~40-60 GB on disk when done. PREP_JOBS=n throttles on a
#      smaller box; SKIP_PREP=1 if the data already exists)
#   2) launches 8 shard workers, one per GPU, in the background
#   3) waits and reports per-shard verdicts
#     bash bash_scripts/explore1_launch          (inside tmux)
# Per-run logs: bash_scripts/logs/explore1/ ; per-shard streams:
# bash_scripts/logs/explore1/shard<g>.out
set -uo pipefail
cd "$(dirname "$0")/.."
LOG=bash_scripts/logs/explore1
mkdir -p "$LOG"

if [ "${SKIP_PREP:-0}" != 1 ]; then
  JOBS=${PREP_JOBS:-7} bash_scripts/prepare_datasets_parallel || exit 1
fi

# fair CPU split: 8 workers each defaulting to all-cores thrashes the host
THREADS=$(( $(nproc) / 8 )); [ "$THREADS" -lt 1 ] && THREADS=1
export OMP_NUM_THREADS=$THREADS MKL_NUM_THREADS=$THREADS

PIDS=()
for g in 0 1 2 3 4 5 6 7; do
  SHARD=$g NSHARDS=8 GPU=$g bash bash_scripts/explore1 \
    > "$LOG/shard$g.out" 2>&1 &
  PIDS+=($!)
  sleep "${STAGGER:-20}"          # de-synchronise the 8 compile+load bursts
done
echo "[explore1] 8 shard workers launched; tail -f $LOG/shard0.out to watch"

FAILED=0
for g in "${!PIDS[@]}"; do
  if wait "${PIDS[$g]}"; then echo "shard $g: ok"
  else echo "shard $g: had failures (see $LOG/shard$g.out)"; FAILED=1
  fi
done
exit $FAILED
