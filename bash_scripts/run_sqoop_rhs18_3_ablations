#!/usr/bin/env bash
# run_sqoop_rhs18_3_ablations
# DATASET: SQOOP rhs=18  (the only dataset this script touches -- generated
# once, on demand, by the first run that needs it)
# 22 runs, ~31 GPU-h sequential on one GPU.
# WHY: makes the flatline table measured rather than asserted: every field cell x2 (predicted .500 throughout) and the gated arms x3 (the family that actually works here)
#     local  : bash bash_scripts/run_sqoop_rhs18_3_ablations
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/run_sqoop_rhs18_3_ablations
# Runs of one cell share a cfg_hash in wandb -- group by it to pool draws
# made on different boxes.
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
LOG="bash_scripts/logs/$CAMPAIGN"
mkdir -p "$LOG"

# one dataset per campaign: built once, serially, before any GPU starts
PREP="task=sqoop"

RUNS=(
  # ---- ablations ----
  "sq_abl_medium_silent_s0      task=sqoop experiment=sqoop/sync/ablations/medium_silent train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_medium_silent_s1      task=sqoop experiment=sqoop/sync/ablations/medium_silent train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_medium_lines_attn_s0  task=sqoop experiment=sqoop/sync/ablations/medium_lines_attn train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_medium_lines_attn_s1  task=sqoop experiment=sqoop/sync/ablations/medium_lines_attn train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_medium_lines_full_s0  task=sqoop experiment=sqoop/sync/ablations/medium_lines_full train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_medium_lines_full_s1  task=sqoop experiment=sqoop/sync/ablations/medium_lines_full train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_medium_lines_phase_s0 task=sqoop experiment=sqoop/sync/ablations/medium_lines_phase train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_medium_lines_phase_s1 task=sqoop experiment=sqoop/sync/ablations/medium_lines_phase train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_addresses_static_s0   task=sqoop experiment=sqoop/sync/ablations/addresses_static train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_addresses_static_s1   task=sqoop experiment=sqoop/sync/ablations/addresses_static train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_addresses_open_s0     task=sqoop experiment=sqoop/sync/ablations/addresses_open train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_addresses_open_s1     task=sqoop experiment=sqoop/sync/ablations/addresses_open train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_identity_cells_only_s0 task=sqoop experiment=sqoop/sync/ablations/identity_cells_only train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_identity_cells_only_s1 task=sqoop experiment=sqoop/sync/ablations/identity_cells_only train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_identity_anchors_only_s0 task=sqoop experiment=sqoop/sync/ablations/identity_anchors_only train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_identity_anchors_only_s1 task=sqoop experiment=sqoop/sync/ablations/identity_anchors_only train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_gated_attn_s0         task=sqoop experiment=sqoop/sync/ablations/gated_attn train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_gated_attn_s1         task=sqoop experiment=sqoop/sync/ablations/gated_attn train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_gated_attn_s2         task=sqoop experiment=sqoop/sync/ablations/gated_attn train.seed=2 wandb.tags=[v16,explore2]"
  "sq_abl_gated_full_s0         task=sqoop experiment=sqoop/sync/ablations/gated_full train.seed=0 wandb.tags=[v16,explore2]"
  "sq_abl_gated_full_s1         task=sqoop experiment=sqoop/sync/ablations/gated_full train.seed=1 wandb.tags=[v16,explore2]"
  "sq_abl_gated_full_s2         task=sqoop experiment=sqoop/sync/ablations/gated_full train.seed=2 wandb.tags=[v16,explore2]"
)

source bash_scripts/_campaign_lib.sh
run_campaign
