#!/usr/bin/env bash
# run_soc_3_ablations
# DATASET: Sort-of-CLEVR  (the only dataset this script touches -- generated
# once, on demand, by the first run that needs it)
# 40 runs, ~28 GPU-h sequential on one GPU.
# WHY: the medium x addressing grid is the L2 evidence; x5 seeds so the ordering (lines_attn > lines_full ~ addresses_static > lines_phase > silent) carries error bars
#     local  : bash bash_scripts/run_soc_3_ablations
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/run_soc_3_ablations
# Runs of one cell share a cfg_hash in wandb -- group by it to pool draws
# made on different boxes.
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
