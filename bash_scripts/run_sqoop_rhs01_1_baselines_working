#!/usr/bin/env bash
# run_sqoop_rhs01_1_baselines_working
# DATASET: SQOOP rhs=1  (the only dataset this script touches -- generated
# once, on demand, by the first run that needs it)
# 29 runs, ~20 GPU-h sequential on one GPU.
# WHY: held-out-pair generalisation is the SQOOP chapter claim: all six baselines x3 and the families that actually work here (gated x5, both token controls)
#     local  : bash bash_scripts/run_sqoop_rhs01_1_baselines_working
#     on vast: python scripts/vast/vast_run.py auto bash_scripts/run_sqoop_rhs01_1_baselines_working
# Runs of one cell share a cfg_hash in wandb -- group by it to pool draws
# made on different boxes.
set -uo pipefail
cd "$(dirname "$0")/.."
CAMPAIGN="$(basename "$0")"
LOG="bash_scripts/logs/$CAMPAIGN"
mkdir -p "$LOG"

# one dataset per campaign: built once, serially, before any GPU starts
PREP="task=sqoop dataset.rhs_variety=1"

