# Copy this file to .env in the SyncNetProject ROOT (beside requirements.txt).
# Never commit the real .env file.
#
# NOTE: vast_run.py reads .env with setdefault -- a variable already exported
# in your shell WINS over the value here, and a duplicate key in this file is
# ignored after the first. Keep one line per key.

GITHUB_TOKEN=
WANDB_API_KEY=

# Optional defaults used by scripts/vast/vast_run.py
VAST_REPO_URL=https://github.com/NikWill2003/SyncNetProject.git
VAST_REPO_BRANCH=main

# CUDA 12.8 covers 4090 (sm_89) AND 5090 (sm_120) and is supported by far more
# hosts than 13.x, whose newer driver requirement can make the container fail
# to start. The "-auto" suffix lets each machine pull the build matching its
# own CUDA. The worker pip-installs torch if the image lacks it, so the image
# choice is not critical.
VAST_IMAGE=vastai/pytorch:cuda-12.8.1-auto
# alternatives if that tag is unavailable:
#   vastai/pytorch:cuda-12.8-auto
#   pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime
#   vastai/base-image:cuda-12.8.1-cudnn-devel-ubuntu22.04-py312
