# Copy this file to .env in the SyncNetProject ROOT (beside requirements.txt).
# Never commit the real .env file.

GITHUB_TOKEN=
WANDB_API_KEY=

# Optional defaults used by scripts/vast/vast_run.py
VAST_REPO_URL=https://github.com/NikWill2003/SyncNetProject.git
VAST_REPO_BRANCH=main
# Prefer an image that SHIPS torch: the -mini- base image has none, so every
# boot downloads torch + ~2.5 GB of CUDA wheels and the version is whatever
# accelerate resolves to. A pytorch image boots faster and keeps torch fixed.
VAST_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
# VAST_IMAGE=vastai/base-image:cuda-13.2-mini-py312-2026-08-26   # torch-less
